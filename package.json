{
  "name": "superagent-platform",
  "version": "0.1.0",
  "description": "研究集成原型，不是生产调度器：Router 把同线程 Trigger 合并进一次 Eval，并用显式 token_budget 截断；Watchdog 在合成轨迹上对照植入故障与干净/慢速控制。不连接在线模型，也没有对生产基线做基准。",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "dev": "tsx src/index.ts",
    "start": "node dist/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "agent",
    "scheduler",
    "router",
    "watchdog",
    "batching",
    "llm-serving"
  ],
  "license": "MIT",
  "dependencies": {
    "better-sqlite3": "^11.3.0",
    "fastify": "^4.28.1",
    "pino": "^9.4.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.11",
    "@types/node": "^22.7.4",
    "tsx": "^4.19.1",
    "typescript": "^5.6.2",
    "vitest": "^2.1.1"
  }
}
