# superagent-platform — environment variables
# Copy to .env and fill in real values. Never commit .env.

# HTTP port for the REST API and dashboard (default: 3081)
PORT=3081

# Path to the JSON config file (default: ./config/config.json)
CONFIG_PATH=./config/config.json

# Path to the SQLite database file (default: ./data/superagent.db)
DB_PATH=./data/superagent.db
